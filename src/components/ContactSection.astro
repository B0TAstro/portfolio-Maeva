---
import type { SocialLink } from '../types/sanity';

type Props = {
	title?: string;
	email?: string;
	socialLinks?: SocialLink[] | null;
};

const { title = '[contact]', email, socialLinks = [] } = Astro.props;
const links = socialLinks ?? [];
---

<section class="contact-section" id="contact">
	<div>
		<p class="label">[contact]</p>
		<h2>{title}</h2>
	</div>
	<div class="contact-actions">
		{email ? <a href={`mailto:${email}`}>{email}</a> : <p>Ajoute un email dans Sanity.</p>}
		{
			links.length > 0 && (
				<div class="social-links">
					{links.map((link) => (
						<a href={link.url} target="_blank" rel="noreferrer">
							{link.label}
						</a>
					))}
				</div>
			)
		}
	</div>
</section>

<style>
	.contact-section {
		display: grid;
		grid-template-columns: minmax(180px, 0.4fr) minmax(0, 1fr);
		gap: clamp(24px, 6vw, 80px);
		padding: clamp(40px, 8vw, 96px) clamp(18px, 5vw, 64px);
		background: #d1d1d1;
	}

	.label,
	h2,
	p {
		margin: 0;
	}

	.label {
		color: #e20d0d;
		font-weight: 800;
	}

	h2 {
		margin-top: 12px;
		font-size: clamp(2rem, 6vw, 5rem);
		line-height: 0.92;
	}

	.contact-actions,
	.social-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	a {
		font-weight: 800;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	@media (max-width: 760px) {
		.contact-section {
			grid-template-columns: 1fr;
		}
	}
</style>
