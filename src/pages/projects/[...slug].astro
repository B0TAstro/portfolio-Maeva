---
import ContactSection from '../../components/ContactSection.astro';
import Layout from '../../layouts/Layout.astro';
import { urlForImage } from '../../lib/sanity.image';
import { getHomePage, getProjectBySlug, getProjectSlugs } from '../../lib/sanity.queries';

export async function getStaticPaths() {
	const projects = await getProjectSlugs();

	return projects.map((project) => ({
		params: { slug: project.slug },
	}));
}

const slug = Astro.params.slug;

if (!slug) {
	throw new Error('Missing project slug.');
}

const [project, home] = await Promise.all([getProjectBySlug(slug), getHomePage()]);

if (!project) {
	throw new Error(`Project not found: ${slug}`);
}
---

<Layout>
	<main>
		<article class="project-detail">
			<header class="project-header">
				<a class="back-link" href={`${import.meta.env.BASE_URL}projects`}>retour</a>
				<div>
					<p class="label">[{project.category ?? 'project'}]</p>
					<h1>{project.title}</h1>
					<p class="subtitle">{project.subtitle ?? project.description}</p>
				</div>
				{project.year && <p class="year">{project.year}</p>}
			</header>

			{
				project.coverImage && (
					<img
						class="cover-image"
						src={urlForImage(project.coverImage).width(1400).height(1100).fit('crop').url()}
						alt={project.coverImage.alt ?? ''}
					/>
				)
			}

			{project.paragraph && <p class="project-paragraph">{project.paragraph}</p>}

			{
				project.gallery && project.gallery.length > 0 && (
					<section class="gallery" aria-label="Galerie du projet">
						{project.gallery.map((image) => (
							<figure>
								<img src={urlForImage(image).width(1200).height(900).fit('crop').url()} alt={image.alt ?? ''} />
								{image.caption && <figcaption>{image.caption}</figcaption>}
							</figure>
						))}
					</section>
				)
			}

			{
				project.url && (
					<a class="external-link" href={project.url} target="_blank" rel="noreferrer">
						voir le projet
					</a>
				)
			}
		</article>

		<ContactSection
			title={home?.contactTitle}
			email={home?.contactEmail}
			socialLinks={home?.socialLinks}
		/>
	</main>
</Layout>

<style>
	.project-detail {
		padding: clamp(40px, 7vw, 96px) clamp(18px, 5vw, 64px);
	}

	.project-header {
		display: grid;
		grid-template-columns: 120px minmax(0, 1fr) auto;
		gap: clamp(20px, 5vw, 72px);
		align-items: start;
		margin-bottom: clamp(36px, 7vw, 96px);
	}

	.back-link,
	.external-link {
		color: #e20d0d;
		font-weight: 800;
		text-decoration: none;
	}

	.label,
	h1,
	p,
	figure {
		margin: 0;
	}

	.label {
		margin-bottom: 20px;
		color: #e20d0d;
		font-weight: 800;
	}

	h1 {
		max-width: 11ch;
		font-size: clamp(4rem, 14vw, 14rem);
		font-style: italic;
		line-height: 0.82;
		letter-spacing: -0.08em;
	}

	.subtitle {
		max-width: 64ch;
		margin-top: 24px;
		font-size: clamp(1.1rem, 2.4vw, 2rem);
		font-weight: 800;
	}

	.year {
		font-weight: 800;
	}

	.cover-image {
		width: min(760px, 100%);
		aspect-ratio: 4 / 5;
		margin: 0 auto;
		object-fit: cover;
		background: #d1d1d1;
	}

	.project-paragraph {
		max-width: 72ch;
		margin: clamp(36px, 7vw, 96px) auto;
		line-height: 1.7;
	}

	.gallery {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 18px;
		margin-top: clamp(36px, 7vw, 96px);
	}

	.gallery img {
		width: 100%;
		aspect-ratio: 4 / 3;
		object-fit: cover;
		background: #d1d1d1;
	}

	figcaption {
		margin-top: 8px;
		font-size: 0.82rem;
	}

	.external-link {
		display: block;
		width: fit-content;
		margin: clamp(36px, 7vw, 96px) auto 0;
		padding: 10px 16px;
		border: 1px solid currentColor;
		border-radius: 999px;
	}

	@media (max-width: 840px) {
		.project-header {
			grid-template-columns: 1fr;
		}

		.gallery {
			grid-template-columns: 1fr;
		}
	}
</style>
