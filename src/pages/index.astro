---
import ContactSection from '../components/ContactSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Layout from '../layouts/Layout.astro';
import { urlForImage } from '../lib/sanity.image';
import { getHomePage } from '../lib/sanity.queries';

const home = await getHomePage();
const projects = home?.selectedProjects ?? [];
---

<Layout>
	<main>
		<section class="hero">
			<div class="hero-copy">
				<p class="label">[home]</p>
				<h1>{home?.heroTitle ?? 'Portfolio Maeva'}</h1>
				<p class="subtitle">
					{home?.heroSubtitle ?? 'Direction artistique, identite visuelle et projets.'}
				</p>
				<p>{home?.aboutText ?? 'Ajoute un document Accueil dans Sanity.'}</p>
			</div>

			{
				home?.heroImage && (
					<img
						class="hero-image"
						src={urlForImage(home.heroImage).width(1000).height(900).fit('crop').url()}
						alt={home.heroImage.alt ?? ''}
					/>
				)
			}
		</section>

		<section class="projects-preview">
			<div class="section-heading">
				<p class="label">[projects]</p>
				<a href={`${import.meta.env.BASE_URL}projects`}>voir tous les projets</a>
			</div>

			{
				projects.length > 0 ? (
					<div class="project-list">
						{projects.map((project) => <ProjectCard project={project} />)}
					</div>
				) : (
					<p class="empty-state">Ajoute des projets selectionnes dans le document Accueil.</p>
				)
			}
		</section>

		<ContactSection
			title={home?.contactTitle}
			email={home?.contactEmail}
			socialLinks={home?.socialLinks}
		/>
	</main>
</Layout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(260px, 0.72fr);
		gap: clamp(24px, 6vw, 80px);
		align-items: end;
		min-height: calc(100vh - 72px);
		padding: clamp(40px, 7vw, 96px) clamp(18px, 5vw, 64px);
	}

	.hero-copy {
		max-width: 980px;
	}

	.label,
	h1,
	p {
		margin: 0;
	}

	.label {
		margin-bottom: 24px;
		color: #e20d0d;
		font-weight: 800;
	}

	h1 {
		max-width: 9ch;
		font-size: clamp(4rem, 16vw, 15rem);
		font-style: italic;
		line-height: 0.82;
		letter-spacing: -0.08em;
	}

	.subtitle {
		margin-top: 28px;
		font-size: clamp(1.2rem, 3vw, 2.4rem);
		font-weight: 800;
	}

	.hero-copy p:last-child {
		max-width: 62ch;
		margin-top: 18px;
		line-height: 1.6;
	}

	.hero-image {
		width: 100%;
		aspect-ratio: 3 / 4;
		object-fit: cover;
		background: #d1d1d1;
	}

	.projects-preview {
		padding: clamp(40px, 7vw, 96px) clamp(18px, 5vw, 64px);
	}

	.section-heading {
		display: flex;
		align-items: end;
		justify-content: space-between;
		gap: 24px;
		margin-bottom: 32px;
	}

	.section-heading a {
		font-weight: 800;
		text-decoration-thickness: 2px;
		text-underline-offset: 5px;
	}

	.empty-state {
		padding: 32px;
		background: #d1d1d1;
	}

	@media (max-width: 840px) {
		.hero {
			grid-template-columns: 1fr;
		}
	}
</style>
